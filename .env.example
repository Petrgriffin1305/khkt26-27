# Web và native cùng ưu tiên URL bên dưới.
# Triển khai web: đặt URL backend HTTPS trước khi build (giá trị được nhúng vào bundle).
# Điện thoại thật: http://<IP-LAN>:3000/api/v1.
# Android emulator: http://10.0.2.2:3000/api/v1. Web/iOS simulator: localhost.
# Để trống để dùng fallback http://localhost:3000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
